{
  "sections": {
    "slideshow_hero": {
      "type": "slideshow",
      "blocks": {
        "slide_1": {
          "type": "_slide",
          "settings": {
            "horizontal_alignment_flex_direction_column": "center",
            "vertical_alignment_flex_direction_column": "center"
          },
          "blocks": {
            "group": {
              "type": "group",
              "settings": {
                "horizontal_alignment_flex_direction_column": "center",
                "width": "custom",
                "custom_width": 60,
                "width_mobile": "custom",
                "inherit_color_scheme": false,
                "color_scheme": "scheme-6",
                "custom_width_mobile": 90,
                "padding-inline-start": 36,
                "padding-inline-end": 36,
                "padding-block-start": 48,
                "padding-block-end": 48
              },
              "blocks": {
                "heading": {
                  "type": "text",
                  "settings": {
                    "text": "<h1>Uncompromising Quality</h1>",
                    "type_preset": "h1"
                  }
                },
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Discover our newest collections, designed with a focus on editorial sophistication, premium materials, and honest craft.</p>",
                    "padding-block-end": 24
                  }
                },
                "button": {
                  "type": "button",
                  "settings": {
                    "label": "Explore New Arrivals",
                    "link": "shopify://collections/all"
                  }
                }
              },
              "block_order": ["heading", "text", "button"]
            }
          },
          "block_order": ["group"]
        },
        "slide_2": {
          "type": "_slide",
          "settings": {
            "horizontal_alignment_flex_direction_column": "center",
            "vertical_alignment_flex_direction_column": "center"
          },
          "blocks": {
            "group": {
              "type": "group",
              "settings": {
                "horizontal_alignment_flex_direction_column": "center",
                "width": "custom",
                "custom_width": 60,
                "width_mobile": "custom",
                "inherit_color_scheme": false,
                "color_scheme": "scheme-6",
                "custom_width_mobile": 90,
                "padding-inline-start": 36,
                "padding-inline-end": 36,
                "padding-block-start": 48,
                "padding-block-end": 48
              },
              "blocks": {
                "heading": {
                  "type": "text",
                  "settings": {
                    "text": "<h1>The Editorial Standard</h1>",
                    "type_preset": "h1"
                  }
                },
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Experience structured shapes, minimal detailing, and high-impact designs loved globally.</p>",
                    "padding-block-end": 24
                  }
                },
                "button": {
                  "type": "button",
                  "settings": {
                    "label": "Shop Best Sellers",
                    "link": "shopify://collections/all"
                  }
                }
              },
              "block_order": ["heading", "text", "button"]
            }
          },
          "block_order": ["group"]
        }
      },
      "block_order": ["slide_1", "slide_2"],
      "settings": {
        "icons_style": "arrow",
        "slideshow_controls_style": "dots",
        "color_scheme": "scheme-5",
        "autoplay": true,
        "autoplay_speed": 5,
        "section_width": "full-width",
        "slide_height": "large",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "scrolling_marquee": {
      "type": "marquee",
      "blocks": {
        "text_marquee": {
          "type": "text",
          "settings": {
            "text": "<h3>COMPLIMENTARY WORLDWIDE EXPRESS DELIVERY — SHOP THE EXCLUSIVE COLLECTION</h3>",
            "type_preset": "h6"
          }
        }
      },
      "block_order": ["text_marquee"],
      "settings": {
        "speed": 12,
        "section_width": "full-width",
        "color_scheme": "scheme-2",
        "padding-block-start": 16,
        "padding-block-end": 16
      }
    },
