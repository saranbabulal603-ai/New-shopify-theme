                  "name": "Story Heading",
                  "settings": {
                    "text": "<h2>Designed for Longevity & Purpose</h2>",
                    "type_preset": "h2"
                  }
                },
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We design with absolute focus on visual longevity, tactile depth, and structural strength. Inspired by premium architectural designs and editorial modern layouts, every product tells an elegant story of luxury.</p>",
