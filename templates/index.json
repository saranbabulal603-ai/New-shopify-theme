        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "space-between"
          },
          "blocks": {
            "caption": {
              "type": "text",
              "name": "Caption",
              "settings": {
                "text": "<p>OUR SIGNATURE CRAFT</p>",
                "type_preset": "h6"
