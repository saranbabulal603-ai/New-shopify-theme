        "columns": 4,
        "mobile_columns": "1",
        "mobile_card_size": "80cqw",
        "columns_gap": 16,
        "rows_gap": 32,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 32,
        "color_scheme": "scheme-1",
        "padding-block-start": 64,
        "padding-block-end": 64
